---
/**
 * @file    ProjectCard.astro
 * @brief   Carte d'un projet mis en avant (accueil) : vignette, titre, métadonnées, accroche, lien.
 * @details Variante `large` pour le projet principal (vignette et texte côte à côte).
 *          Sans image, un emplacement neutre est affiché.
 *          Hover: the card lifts slightly, its border turns to the accent colour and the image zooms in.
 *          The thumbnail carries a view-transition name shared with the project page media.
 */
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
import { getCoverImage } from '../lib/media';
import { getProjectText } from '../lib/projects';
import { localePath, shortEngine, teamLabel, useTranslations, type Lang } from '../i18n/ui';

interface Props { project: Project; lang: Lang; large?: boolean }
const { project, lang, large = false } = Astro.props;
const t = useTranslations(lang);
const d = project.data;
const cover = getCoverImage(project.id, d.couverture);
const href = localePath(lang, `projets/${project.id}`);
const meta = [shortEngine(d.moteur), teamLabel(d.equipe, lang), d.duree?.[lang]].filter(Boolean).join(' · ');
const accroche = (await getProjectText(project.id, lang)).tagline;
---
<article class:list={['card', { large }]}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true" style={`view-transition-name: project-${project.id}`}>
    {cover
      ? <Image src={cover} alt="" widths={[480, 800, 1200]} sizes={large ? '(min-width: 900px) 560px, 100vw' : '(min-width: 900px) 360px, 100vw'} />
      : <span class="placeholder" />}
  </a>
  <div class="body">
    {large && <p class="eyebrow-accent">{t('projects.main')}{d.enCours && ` · ${t('projects.inProgress')}`}</p>}
    <h3><a href={href}>{d.titre[lang]}</a></h3>
    <p class="meta">{meta}</p>
    {accroche && <p class="pitch">{accroche}</p>}
    <a class="more" href={href} aria-hidden="true" tabindex="-1">{t('projects.see')} →</a>
  </div>
</article>

<style>
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card);
    overflow: hidden; display: flex; flex-direction: column; position: relative;
    transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
  }
  .card:hover { background: var(--surface-2); border-color: var(--accent); transform: translateY(-3px); }
  .large { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .thumb { display: block; aspect-ratio: 16 / 9; background: var(--surface-2); overflow: hidden; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .card:hover .thumb :global(img) { transform: scale(1.03); }
  .placeholder { display: block; width: 100%; height: 100%; }
  .body { padding: 20px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
  .large .body { padding: 32px; justify-content: center; }
  h3 { font-size: 20px; line-height: 1.3; }
  .large h3 { font-size: 24px; }
  h3 a { color: var(--text); }
  /* Toute la carte est cliquable via le lien du titre. */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:hover { text-decoration: none; }
  .card:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  h3 a:focus-visible { outline: none; }
  .pitch { color: var(--text-2); }
  .more { margin-top: auto; padding-top: 8px; font-weight: 500; color: var(--accent); }
  .eyebrow-accent { font-family: var(--font-mono); font-size: 13px; color: var(--accent); }
</style>
