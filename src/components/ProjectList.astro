---
/**
 * @file    ProjectList.astro
 * @brief   Projets secondaires (cartes compactes) et archives (bloc repliable, visible au clic).
 */
import type { Project } from '../lib/projects';
import { formatDate, localePath, shortEngine, teamLabel, useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; secondary: Project[]; archived: Project[] }
const { lang, secondary, archived } = Astro.props;
const t = useTranslations(lang);
const year = (p: Project) => formatDate(p.data.debut.slice(0, 4), lang);
---
{secondary.length > 0 && (
  <>
    <h3 class="sub">{t('projects.others')}</h3>
    <ul class="compact" role="list">
      {secondary.map((p) => (
        <li>
          <a href={localePath(lang, `projets/${p.id}`)}>
            <span class="name">{p.data.titre[lang]}</span>
            <span class="meta">{[shortEngine(p.data.moteur), p.data.langages.join(', '), teamLabel(p.data.equipe, lang)].join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>
  </>
)}

{archived.length > 0 && (
  <details class="archives">
    <summary>{t('projects.archives')} · {t('projects.archivesCount', { n: archived.length })}</summary>
    <ul role="list">
      {archived.map((p) => (
        <li>
          <a href={localePath(lang, `projets/${p.id}`)}>{p.data.titre[lang]}</a>
          <span class="meta">{[shortEngine(p.data.moteur), p.data.langages.join(', '), teamLabel(p.data.equipe, lang), year(p)].join(' · ')}</span>
        </li>
      ))}
    </ul>
  </details>
)}

<style>
  .sub { margin: 64px 0 16px; font-size: 20px; }
  .compact { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; }
  .compact a {
    display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 16px; color: var(--text);
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card); transition: background-color .15s;
  }
  .compact a:hover { background: var(--surface-2); text-decoration: none; }
  .name { font-weight: 600; }
  .compact .meta { font-size: 13px; }
  .archives { margin-top: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card); }
  .archives summary {
    cursor: pointer; min-height: 48px; padding: 12px 16px; display: flex; align-items: center;
    font-family: var(--font-mono); font-size: 14px; color: var(--text-2);
  }
  .archives summary:hover { color: var(--text); }
  .archives ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .archives li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 12px 16px; }
  .archives li + li { border-top: 1px solid var(--border); }
  .archives li a { color: var(--text); font-weight: 500; }
  .archives .meta { font-size: 13px; }
</style>
