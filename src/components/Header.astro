---
/**
 * @file    Header.astro
 * @brief   En-tête : nom, navigation vers les sections de l'accueil, sélecteur de langue FR / EN.
 * @details Sélecteur en texte (pas de drapeaux), libellé accessible dans la langue cible,
 *          attributs lang/hreflang et aria-current sur la langue active.
 *          En mobile, la navigation passe dans un menu <details> (fonctionne sans JavaScript).
 */
import Icon from './Icon.astro';
import { languages, langs, localePath, switchLangPath, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
  /** true : le sélecteur de langue pointe vers les accueils (pages sans équivalent traduit). */
  langToHome?: boolean;
}
const { lang, langToHome = false } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const links = [
  { href: `${home}#projets`, label: t('nav.projects') },
  { href: `${home}#parcours`, label: t('nav.background') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>{site.name}</a>

    <nav class="nav-desktop" aria-label={t('nav.label')}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="right">
      <p class="lang" aria-label={t('lang.label')}>
        {langs.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> / </span>}
            <a
              href={langToHome ? localePath(l) : switchLangPath(Astro.url.pathname, l)}
              lang={l}
              hreflang={l}
              aria-label={languages[l]}
              aria-current={l === lang ? 'true' : undefined}
            >{l.toUpperCase()}</a>
          </>
        ))}
      </p>
      <details class="nav-mobile">
        <summary aria-label={t('nav.menu')}><Icon name="menu" size={18} /></summary>
        <nav aria-label={t('nav.label')}>
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  /** @brief Referme le menu mobile après un clic sur un lien de navigation. */
  document.querySelectorAll<HTMLDetailsElement>('.nav-mobile').forEach((menu) => {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--border); background: var(--bg); position: sticky; top: 0; z-index: 5; }
  .bar { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { color: var(--text); font-weight: 600; white-space: nowrap; }
  .brand:hover { color: var(--text); text-decoration: none; }
  .nav-desktop { display: flex; gap: 28px; font-size: 15px; margin-left: auto; }
  .nav-desktop a, .nav-mobile nav a { color: var(--text-2); }
  .nav-desktop a:hover, .nav-mobile nav a:hover { color: var(--text); text-decoration: none; }
  .right { display: flex; align-items: center; gap: 12px; }
  .lang { font-family: var(--font-mono); font-size: 14px; color: var(--text-3); white-space: nowrap; }
  .lang a { color: var(--text-3); display: inline-block; padding: 10px 2px; }
  .lang a[aria-current='true'] { color: var(--text); }
  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary {
    list-style: none; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--border-control); border-radius: var(--radius-ctrl); color: var(--text);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile nav {
    position: absolute; right: 0; top: 52px; min-width: 200px; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card); padding: 8px;
  }
  .nav-mobile nav a { padding: 10px 12px; border-radius: var(--radius-ctrl); }
  .nav-mobile nav a:hover { background: var(--surface-2); }
  @media (max-width: 639px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
    .bar { height: 56px; }
  }
</style>
