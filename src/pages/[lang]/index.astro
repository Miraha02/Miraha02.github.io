---
/**
 * @file    [lang]/index.astro
 * @brief   Accueil (une page par langue) : présentation, projets, parcours, contact.
 * @details Structure validée sur les maquettes du 17/10/2026. Le premier projet « principal »
 *          s'affiche en grand ; les secondaires en cartes compactes ; les archives repliées.
 */
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectList from '../../components/ProjectList.astro';
import Timeline from '../../components/Timeline.astro';
import { formatDate, formatPeriod, langs, useTranslations, type Lang } from '../../i18n/ui';
import { getPublishedProjects } from '../../lib/projects';
import { cvPath, site } from '../../lib/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const profil = await getEntry('profil', lang);
const { Content: Presentation } = profil ? await render(profil) : { Content: null };
const description = (profil?.body ?? '').replace(/\s+/g, ' ').trim().slice(0, 155);

const projects = await getPublishedProjects();
const principal = projects.filter((p) => p.data.categorie === 'principal');
const [featured, ...highlights] = principal;
const secondary = projects.filter((p) => p.data.categorie === 'secondaire');
const archived = projects.filter((p) => p.data.categorie === 'archive');

const formation = (await getCollection('formation')).sort((a, b) => a.data.ordre - b.data.ordre).map(({ data }) => ({
  period: `${formatDate(data.debut, lang)} – ${data.fin ? formatDate(data.fin, lang) : (data.finTexte?.[lang] ?? '')}`,
  title: data.diplome[lang],
  place: data.etablissement[lang],
}));
const experiences = (await getCollection('experiences')).sort((a, b) => a.data.ordre - b.data.ordre).map(({ data }) => ({
  period: formatPeriod(data.debut, data.fin, lang),
  title: data.poste[lang],
  place: data.structure[lang],
  text: data.description[lang],
}));
const cv = cvPath(lang);
---
<Base lang={lang} description={description}>
  <section class="container hero">
    <p class="role">{t('site.role')}</p>
    <h1>{site.name}</h1>
    <div class="prose intro">{Presentation && <Presentation />}</div>
    <div class="actions">
      <a class="btn btn-primary" href="#projets">{t('hero.projects')}</a>
      {cv && <a class="btn btn-secondary" href={cv} download><Icon name="download" />{t('cv')}</a>}
      <a class="btn btn-secondary icon-only" href={site.github.url} aria-label="GitHub"><Icon name="github" size={18} /></a>
    </div>
  </section>

  <section id="projets" class="band">
    <div class="container block">
      <h2>{t('projects.title')}</h2>
      {featured && <div class="featured"><ProjectCard project={featured} lang={lang} large /></div>}
      {highlights.length > 0 && (
        <div class="grid">
          {highlights.map((p) => <ProjectCard project={p} lang={lang} />)}
        </div>
      )}
      <ProjectList lang={lang} secondary={secondary} archived={archived} />
    </div>
  </section>

  <section id="parcours" class="band">
    <div class="container block">
      <h2>{t('background.title')}</h2>
      <div class="two-cols">
        <Timeline heading={t('background.education')} items={formation} highlightFirst />
        <Timeline heading={t('background.experience')} items={experiences} />
      </div>
    </div>
  </section>

  <section id="contact" class="band">
    <div class="container block">
      <h2>{t('contact.title')}</h2>
      <div class="actions">
        <a class="btn btn-secondary mono-btn" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
        <a class="btn btn-secondary mono-btn" href={site.github.url}><Icon name="github" />github.com/{site.github.user}</a>
        {cv && <a class="btn btn-primary" href={cv} download><Icon name="download" />{t('cv')}</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 96px; padding-bottom: 80px; }
  .role { font-family: var(--font-mono); font-size: 14px; color: var(--accent); margin-bottom: 12px; }
  h1 { font-size: 48px; line-height: 1.1; margin-bottom: 20px; }
  .intro { font-size: 18px; margin-bottom: 32px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .icon-only { width: 46px; padding: 0; }
  .mono-btn { font-family: var(--font-mono); font-size: 14px; font-weight: 400; }
  .block { padding-top: 64px; padding-bottom: 64px; }
  h2 { font-size: 28px; margin-bottom: 32px; }
  .featured { margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; }
  .two-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; }
  @media (max-width: 639px) {
    .hero { padding-top: 48px; padding-bottom: 40px; }
    h1 { font-size: 32px; }
    .intro { font-size: 16px; }
    h2 { font-size: 24px; margin-bottom: 24px; }
    .block { padding-top: 40px; padding-bottom: 40px; }
  }
</style>
