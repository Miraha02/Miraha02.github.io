---
/**
 * @file    Base.astro
 * @brief   Gabarit commun à toutes les pages : <head> (SEO, Open Graph, langues alternatives),
 *          polices, styles globaux, en-tête, pied de page et statistiques GoatCounter.
 * @details L'image de partage (Open Graph) est générée au build en 1200×630.
 */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, switchLangPath, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../lib/site';
import { getCoverImage } from '../lib/media';

interface Props {
  lang: Lang;
  /** Titre de la page ; le nom du site est ajouté automatiquement. */
  title?: string;
  description: string;
  ogImage?: ImageMetadata;
  /** Page sans équivalent par langue (ex. 404) : pas de liens hreflang. */
  noAlternates?: boolean;
}

const { lang, title, description, ogImage, noAlternates = false } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${site.name}` : t('site.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareSource = ogImage ?? getCoverImage('shadowsteps', 'ShadowSteps3.png');
const share = shareSource
  ? await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_GB';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noAlternates && langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(switchLangPath(Astro.url.pathname, l), Astro.site)} />
    ))}
    {!noAlternates && <link rel="alternate" hreflang="x-default" href={new URL(switchLangPath(Astro.url.pathname, 'fr'), Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#121417" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {share && <meta property="og:image" content={new URL(share.src, Astro.site)} />}
    {share && <meta property="og:image:width" content="1200" />}
    {share && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    {site.goatcounterCode && (
      <script
        is:inline
        async
        data-goatcounter={`https://${site.goatcounterCode}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#contenu">{t('nav.skip')}</a>
    <Header lang={lang} langToHome={noAlternates} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 16px; top: -48px; z-index: 10;
    background: var(--accent); color: var(--on-accent); padding: 8px 14px; border-radius: var(--radius-ctrl);
  }
  .skip:focus { top: 12px; }
</style>
